# Caddy: recebe as conexões da internet, obtém e renova o certificado HTTPS
# sozinho (Let's Encrypt) e repassa para o painel, que só escuta em 127.0.0.1.
# Gerado por deploy/vps/instalar-vps.sh a partir deste modelo.
{
	email __EMAIL__
}

# Cabeçalhos de segurança, usados no endereço principal e no www.
(seguranca) {
	header {
		# O navegador passa a usar só HTTPS neste domínio.
		Strict-Transport-Security "max-age=31536000"
		-Server
		# O painel já manda estes cabeçalhos. O "?" só os coloca quando a resposta
		# não tem (respostas do próprio Caddy, como o aviso de "servidor reiniciando").
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "same-origin"
		?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
	}
}

__DOMINIO__ {
	encode gzip

	# Mesmo limite do painel (TAMANHO_MAX_MB) para envio de vídeos.
	request_body {
		max_size 500MB
	}

	import seguranca

	reverse_proxy 127.0.0.1:5000

	log {
		output file /var/log/caddy/painel.log {
			roll_size 10MiB
			roll_keep 10
		}
	}
}
